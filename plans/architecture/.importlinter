[importlinter]
root_package = warmly
include_external_packages = True

# Layers from highest to lowest. A module may import from layers below it and
# never from layers above. Layers in parentheses do not exist yet; they are
# listed so the rule already holds when they are added.
[importlinter:contract:layers]
name = Enforce layered architecture
type = layers
layers =
    warmly.main
    warmly.contract
    warmly.app
    warmly.middleware
    warmly.api
    (warmly.services)
    (warmly.auth)
    warmly.db
    warmly.schemas
    warmly.logs
    warmly.config

# The wire contract must stay free of framework and storage concerns.
[importlinter:contract:schemas-are-pure]
name = Schemas do not depend on the web framework or storage
type = forbidden
source_modules =
    warmly.schemas
forbidden_modules =
    fastapi
    starlette
    uvicorn
    psycopg
    psycopg_pool

# Only the database layer talks to PostgreSQL.
[importlinter:contract:db-driver-is-contained]
name = Only warmly.db imports the database driver
type = forbidden
source_modules =
    warmly.api
    warmly.middleware
    warmly.schemas
    warmly.logs
    warmly.config
forbidden_modules =
    psycopg
    psycopg_pool
