# ---------------------------------------------------------------------------
# Secrets & environment — never commit (PRD §8: no keys, secrets or plaintext)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
secrets/
supabase/.env
supabase/.temp/
supabase/.branches/
# Never commit real user data / production exports / recovery material
*.recovery-key*
prod-data/
backups/

# Claude Code local settings
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Python (FastAPI backend)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.hypothesis/
.import_linter_cache/

# Coverage / reports
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml
test-results/
bandit-report.json

# Mutation testing (mutmut / Stryker)
.mutmut-cache
mutants/
mutmut-report.xml
.stryker-tmp/
reports/

# ---------------------------------------------------------------------------
# Node / TypeScript (PWA frontend)
# ---------------------------------------------------------------------------
node_modules/
*.tsbuildinfo
.npm/
.eslintcache
.vite/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# Playwright / E2E
playwright-report/
blob-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.log
