# Copy to .env.local (never committed) to run against a Supabase project.
# Leave both unset to use the in-memory account doubles in development.

# Frontend (read at build time by Vite). The publishable key is public by
# design. Never put a secret or service-role key in a VITE_ variable: every
# VITE_ value is shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# API (read from the process environment, not from this file).
# WARMLY_AUTH_ISSUER=<project URL>/auth/v1
# WARMLY_AUTH_AUDIENCE=authenticated
